# C++'s lints (PRC-10, A2.2), which tools/check.sh runs with clang-tidy 18 over every C++ project it builds, on our
# own headers only (its --header-filter).
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  cppcoreguidelines-narrowing-conversions,
  misc-redundant-expression,
  misc-unused-using-decls
WarningsAsErrors: "*"
