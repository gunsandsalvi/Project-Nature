; Kindling's Godot project (A2.1, A2.2). tools/build.sh writes config/version for each step.

config_version=5

[application]

config/name="Kindling"
config/version="α1.5b"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false
run/max_fps=60

[display]

window/size/viewport_width=540
window/size/viewport_height=1200
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[shader_globals]

kd_texel_least={
"type": "float",
"value": 0.0
}
kd_origin_tile={
"type": "vec2",
"value": Vector2(0, 0)
}

[rendering]

renderer/rendering_method="mobile"
rendering_device/driver.android="vulkan"
textures/vram_compression/import_etc2_astc=true

[threading]

worker_pool/max_threads=3
