; P7 World generation (IMPLEMENTATION α0.5a): the generator's Godot extension, built from prototypes/worldgen/extension
; for the cloud's tests (Linux) and for the phone (arm64 Android, by tools/build.sh); its libraries are never
; committed. Pre-production code (research 00).
[configuration]

entry_symbol = "worldgen_init"
compatibility_minimum = "4.5"

[libraries]

linux.x86_64 = "res://worldgen/bin/libworldgen.linux.x86_64.so"
android.arm64 = "res://worldgen/bin/libworldgen.android.arm64.so"
