; P5 The same bits (IMPLEMENTATION α0.4a): the toy world's Godot extension, built from prototypes/samebits/extension
; for the cloud's tests (Linux) and for the phone (arm64 Android, by tools/build.sh); its libraries are never
; committed. Pre-production code (research 00).
[configuration]

entry_symbol = "samebits_init"
compatibility_minimum = "4.5"

[libraries]

linux.x86_64 = "res://samebits/bin/libsamebits.linux.x86_64.so"
android.arm64 = "res://samebits/bin/libsamebits.android.arm64.so"
