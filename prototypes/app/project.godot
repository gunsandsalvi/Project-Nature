; Kindling's prototype app: the self-check, and a menu of the phone prototypes as the plan brings them (α0.1a).
; Pre-production code, thrown away with the prototypes (research 00).
config_version=5

[application]

config/name="Kindling"
config/version="α0.1a"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"

[display]

window/size/viewport_width=400
window/size/viewport_height=400
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.android="vulkan"
textures/canvas_textures/default_texture_filter=0
