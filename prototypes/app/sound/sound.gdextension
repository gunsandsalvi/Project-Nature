; P14 Sound (IMPLEMENTATION α0.7c): the sound library's Godot extension, built from prototypes/sound/extension
; for the cloud's tests (Linux) and for the phone (arm64 Android, by tools/build.sh); its libraries are never
; committed. Pre-production code (research 00).
[configuration]

entry_symbol = "sound_init"
compatibility_minimum = "4.5"

[libraries]

linux.x86_64 = "res://sound/bin/libsound.linux.x86_64.so"
android.arm64 = "res://sound/bin/libsound.android.arm64.so"
