// B04-2: FlatBuffers schema for a saved moment (zero-copy). Same records as phone/src/data.rs.
namespace kfb;

struct Cell { elev:float; water:float; soil:[ushort:4]; veg:[ushort:4]; snow:ushort; temp:short; flags:uint; }
struct Patch { b:[ushort:4]; }
struct Animal { id:uint; species:ushort; flags:ushort; x:uint; y:uint; energy:float; health:float; age:uint; herd:uint; }
struct Thing { id:uint; kind:ushort; material:ushort; x:uint; y:uint; z:short; condition:ushort; mass:uint; owner:uint; made:int; }
struct Memory { day:int; kind:ushort; valence:short; subject:uint; place:uint; strength:float; detail:uint; }
struct Relation { other:uint; kind:ushort; trust:short; affection:short; fear:short; last_day:int; }
struct PersonCore { id:uint; born:int; x:uint; y:uint; band:uint; flags:uint; body:[float:16]; needs:[float:8]; feel:[float:8]; skills:[ushort:32]; traits:[ubyte:40]; }

table Person { core:PersonCore; memories:[Memory]; relations:[Relation]; }
table Region { id:ushort; hash:ulong; cells:[Cell]; patches:[Patch]; people:[Person]; animals:[Animal]; things:[Thing]; }
table Moment { day:ulong; seed:ulong; w:uint; h:uint; np:uint; na:uint; nt:uint; regions:[Region]; }
root_type Moment;
