# Godot's caches; each .import file stays, since it holds that file's import settings
.godot/
# gdUnit4, copied into each Godot project from the cache by tools/check.sh (tools/setup.sh pins it)
**/addons/gdUnit4/
# C++ builds (sim/, view/) and the Android plug-in's
/build/
/sim/build/
/view/build/
/android/plugin/build/
/android/plugin/.gradle/
# the note's page, made from dist/NOTE.md at delivery
/dist/note/
__pycache__/
*.tmp

# tools/reel.sh's passing window size
override.cfg
# the game's built extension and its copy of data/, made by tools/check.sh and tools/build.sh (A2.1)
/game/bin/
/game/data/
